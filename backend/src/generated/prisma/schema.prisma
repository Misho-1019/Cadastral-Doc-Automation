generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DescriptionHistory {
  id               String   @id @default(uuid())
  documentType     String
  identifier       String?
  description      String
  extractedData    Json?
  validationErrors Json?
  performance      Json?
  fileName         String?
  createdAt        DateTime @default(now())
}
